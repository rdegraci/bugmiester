llm:
  # openai | anthropic | xai | mock — lock default after bakeoff (see README)
  provider: openai
  # Optional override; defaults applied per provider when null
  base_url: null
  # Prefer a fast/cheap model for generation (10 calls/round).
  # Lock provider+model after the bakeoff (see README).
  model: gpt-5.6-terra
  temperature: 0.55
  judge_temperature: 0.0
  timeout_seconds: 60

game:
  bugs_per_round: 10
  language: swift
  # beginner_mix | intermediate_mix | senior_mix
  # senior_mix ramps Simple slop → Common senior → Gnarly (reentrancy, continuation, exclusivity)
  mix: senior_mix

scoring:
  mode: hybrid              # keyword | llm_judge | hybrid (MVP default: hybrid)
  points_per_bug: 10
  partial_credit: true
  # When judge is unsure, prefer partial / soft correct over harsh wrong
  generosity: prefer_partial_on_low_confidence

freshness:
  avoid_list_max: 20
  similarity_reject_threshold: 0.72
  # Total generate attempts per bug including the first (JSON repair + freshness share this)
  max_generate_attempts: 2
  max_category_repeats_per_round: 1   # unique bug class until the pool runs out
  shuffle_seeds: true                 # new seed order each round
  recent_seed_rounds: 3               # do not redraw these completed rounds' seeds first

resilience:
  max_judge_calls_per_submit: 1
  use_canned_fallback_on_generate_exhaustion: true
  prefetch_next_bug: true          # start next generate while player answers (optional)

recovery:
  enabled: true                    # partial-credit quiz; off = reveal and continue
  choice_count: 4                  # 1 correct + (n-1) distractors (3–5)
  timeout_seconds: 4               # LLM distractor budget; then seed-bank fallback
  max_llm_calls: 1                 # one attempt per partial; 0 = seed-bank only
  use_seed_bank_fallback: true     # still show a quiz if the extra call fails

metrics:
  log_per_bug: true                # latency, generate_attempts, freshness_rejects, judge_called
  log_dir_name: logs               # under Application Support

reports:
  enabled: true
  dir_name: reports                # under Application Support

feedback:
  analyze_on_ops_load: true
  # Post-MVP: suggestion_llm: true, auto_apply_seed_weights: false

adaptation:
  enabled: true                  # Phase 2+: reinforce isolation before Gnarly
  cluster: isolation             # v1 concept cluster
  miss_threshold: 2              # Common-band misses before delaying Gnarly
  max_delayed_gnarly: 1          # cap delayed gnarly slots per round
  cross_round: false             # Phase 4: weakness.json memory

server:
  host: 127.0.0.1
  port: 8765
